# Copie para .env e ajuste os valores:  cp .env.example .env   (PowerShell: Copy-Item .env.example .env)
# Todas as variáveis têm valor padrão no docker-compose.yml; o .env é opcional.

# ---------------- RabbitMQ ----------------
# Usuário/senha do RabbitMQ (painel http://localhost:15672 e conexões AMQP dos serviços).
# Troque a senha em qualquer ambiente que não seja de demonstração.
RABBITMQ_USER=admin
RABBITMQ_PASS=admin123
# Portas publicadas no host
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# ---------------- Gerador (Container 1) ----------------
# Mensagens por segundo (mínimo exigido: 5)
MESSAGES_PER_SECOND=10
# Fração de avaliações de produtos (0.5 = 50% avaliações / 50% suporte)
REVIEW_RATIO=0.5
# A cada N mensagens publica uma "venenosa" para demonstrar a DLQ (0 = desligado)
POISON_EVERY_N=0
# Loga cada mensagem publicada (false = apenas o resumo por segundo)
LOG_EACH_MESSAGE=true

# ---------------- Consumidores (Containers 3 e 4) ----------------
# Atraso artificial por mensagem (ms). 1000 ms = ~1 msg/s por consumidor -> filas crescem.
PROCESSING_DELAY_MS=1000
# Máximo de mensagens não confirmadas (unacked) por consumidor
PREFETCH_COUNT=1

# ---------------- Geral ----------------
TZ=America/Sao_Paulo
LOG_LEVEL=INFO
